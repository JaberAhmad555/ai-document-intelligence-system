# Public configuration only. Never put API keys or backend credentials here.
# / uses the same origin. Vite dev/preview proxies /api to the backend below.
VITE_API_BASE_URL=/
DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Match backend MAX_UPLOAD_FILES, MAX_FILE_SIZE_MB, MAX_UPLOAD_TOTAL_MB.
# These are client-side checks; the backend remains authoritative.
VITE_MAX_UPLOAD_FILES=10
VITE_MAX_FILE_SIZE_MB=25
VITE_MAX_UPLOAD_TOTAL_MB=100

# On Vercel set VITE_API_BASE_URL to the deployed backend origin.
# Do not append /api. Rebuild after changing VITE_ variables.
