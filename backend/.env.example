# Copy this file to backend/.env for local development.
# Never commit backend/.env.

APP_NAME="Document Intelligence API"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Relative SQLite paths resolve against the backend directory.
# Production will use a PostgreSQL URL supplied through the environment.
DATABASE_URL=sqlite+pysqlite:///./data/document_intelligence.db

# Phase 1A implements local storage only.
# Relative storage paths also resolve against the backend directory.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads

# Upload limits
MAX_UPLOAD_FILES=10
MAX_FILE_SIZE_MB=25
MAX_UPLOAD_TOTAL_MB=100
UPLOAD_CHUNK_SIZE_BYTES=1048576

# Archive-based XLSX validation limits
MAX_ARCHIVE_ENTRIES=10000
MAX_ARCHIVE_UNCOMPRESSED_MB=256
MAX_ARCHIVE_COMPRESSION_RATIO=200

# Prevent accidental decoding of extremely large images.
MAX_IMAGE_PIXELS=40000000

# Lists must use JSON syntax in environment variables.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Initial persistent-job retry and lease settings.
# Actual worker behavior will be implemented in Phase 1B.
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=300

# For application start commands and later hosting configuration.
HOST=127.0.0.1
PORT=8000
